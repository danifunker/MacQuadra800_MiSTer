# P174b (P174 + the fast_span_ack change) seed 24: 39,158 ALMs, routing failed (seed lottery at 93 %).
# P175b (53f7f53): the instruction side's own hint bus (mem_ihint_addr; a mirror tag RAM and mirror data banks read it
# every clock for fast_ihit) and a one-clock fill hold after an instruction acknowledge.  Sim vs P174: Permute -1.5 %,
# Whetstone -0.8 %, Dhrystone -1.8 %, Queens -1.2 %.  FIRST FIT: 84,851 ALMs estimated, 104k registers -- the
# full-depth data mirror (28 M10K) took the RAM estimate over the device and Quartus turned the OSD and palette
# buffers into registers.  The mirrors were halved to their own bank's rows (P175c).
# P177 (57a3356): a return-address stack hint for the RTS target fetch.  Sim vs P175b: Permute -3.0 %, Dhrystone -1.1 %.
# NOTE: Quartus rewrites this file during a flow (it inlined the sourced profile's macros once); clean it after.
# P178 (with P175c): the one-clock hit across two lines (the mirror tag RAM's port B reads the next row, the pair banks
# its word 0).  Sim vs P177: Permute -2.1 %, Whetstone -1.2 %, Dhrystone -1.6 %.  sys_top passes PALETTE=false without
# MISTER_FB (the dead 128x48 palette Quartus kept turning into 6,144 registers).  Synthesis estimate 39,043 ALMs.
# P178 seed 24 2026-09-22 (8ce901c): 39,386 ALMs (94 %), 513 RAM blocks, routes; CPU clock -0.505 ns (the day's best),
# HDMI +0.177, clk_ram +0.441.  rbf scratch/p178_xline_fit_20260922/MacQuadra800_p178_xline_8ce901c.rbf.
# P178 ON HARDWARE (2026-09-22 evening): hangs during 8.1 extension loading (a blank alert, no disk activity).
# Reproduced in the full-machine sim as "~ATM error type 10" (F-line) at ~70 guest-seconds, but only in some runs
# (host-side options change the interleaving): a race, not a plain logic error.  P174 boots and benchmarks (Mix
# 1.460).  The tree's CPU RTL is back at P174 (c152ac4); P175c/P177/P178 live in history (8ce901c) and
# scratch/p178_state_20260922/ until the race is found.  The P178-off bisect fits failed routing (seeds 24, 25).
# P179 seed 24 2026-09-22 (182109d): 39,113 ALMs (93 %), 508 RAM blocks, routes; CPU clock -3.153 ns (the known
# path: ifr_addr -> MMU hint match -> cache fast_pair_idle -> c_rdata -> pipeline ALU -> rd_bcc_fl/dgo -> aer_wd;
# no P179 logic on it), clk 1 -1.250, HDMI -0.386.  Too far out for hardware; not run.
# P182 seed 24 2026-09-23 (122dab4): 39,229 ALMs (94 %), routes; CPU clock -0.718 ns (P174 -0.920 ran fine),
# clk 1 +0.619, HDMI +0.029.  rbf scratch/p182_storehint_fit_20260922/MacQuadra800_p182_storehint_122dab4.rbf.
# P184 seed 24 2026-09-23 (78f05d7, lite profile): 39,567 ALMs (94 %), routing FAILED (congestion).
# P186 seed 24 2026-09-23 (3fd022b, development profile): 38,505 ALMs (92 %), routes; CPU clock -1.722 ns, HDMI +0.030,
# clk 1 +0.563; clk_ram->clk_sys crossing FAILED -1.369 ns (sdram_beat32 wq_rp_handoff -> wq_room -> quadra800's write
# registers: a falling-edge handoff through logic).  Not run.  P188 resynchronizes the pointer (one register) first.
# P188 seed 24 2026-09-23 (f64a2d1, development profile): 38,735 ALMs (92 %), routes; CPU clock -1.671 ns, HDMI -0.070,
# clk 1 +0.145, clk_sys<->clk_ram crossings met (+0.506 / +0.825).  HARDWARE: Mix 1.631 (P182 1.467).
# P190 seed 24 2026-09-23 (e624537, development profile): 38,570 ALMs (92 %), routing FAILED (congestion).  Seed 25 next,
# with P191-P193.
# P193 seed 25 2026-09-23 (970b98c, development profile): 38,893 ALMs (93 %), routes; CPU clock -1.335 ns, HDMI +0.474,
# clk 1 +0.271, crossings met (+1.359 / +0.852).  rbf md5 62d1d13b.
# P195 seed 25 2026-09-23 (aef55e2): STOPPED -- synthesis put the byte-enabled cache data arrays in registers (514,863
# registers; Quartus did not infer byte enables from slice writes into [31:0] arrays).  P195b splits them into byte lanes.
# P197 seed 25 2026-09-23 (c4a3522, development profile): STOPPED after 1 h 45 min in quartus_fit with no output after
# its pre-placement physical synthesis (P188/P193 took 17-26 min for the whole flow); cause not found.  Superseded by P205.
# P205 seed 25 2026-09-23 (887945b, development profile): 39,109 ALMs (93 %), 504 RAM blocks, routes in ~12 min; CPU clock
# -1.326 ns, HDMI +0.314, clk_ram +0.514, bridge crossings met (+1.207 / +0.976).  md5 a98eaf296dd7a20819387d15c2387b4b.
# P205 on hardware: Mix 1.703 (P193 1.646).
# P209 seed 25 2026-09-23 (8e4d06e): 39,224 ALMs (94 %), routes with congestion warnings; CPU clock -2.220 ns (debug_busy /
# ifr_addr -> epf_data), HDMI +0.191, crossings met.  NOT run: carries the P207 read-after-store bug (CMPM/ADDX memory
# modes lost their An update), fixed with P210-P212.
# P212 seed 25 2026-09-23 (c214e74): 39,413 ALMs (94 %); CPU clock -1.446 ns (cache tag RAM -> core), HDMI +0.504,
# clk_ram +0.453, crossings met.  md5 c829f5a0045b7a7d464536227b3e59f0.
# P214 seed 25 2026-09-23 (73783ab): 39,163 ALMs (93 %); routing FAILED (congestion).  Seed 26 next, with P215.
# P215 seed 26 2026-09-23 (bc45d86): STOPPED after 76 min of "exceedingly large" routing congestion.  Next: P216-P220 with
# CACHE_TINY in the development profile (configs/cpu_development.tcl) for routing room, seed 25.
# P220 seed 25 2026-09-23 (1a38ef8, CACHE_TINY): 39,078 ALMs (93 %), routes; CPU clock -2.596 ns (mem_addr_q -> MMU
# request translation -> epf_data), HDMI +0.366, crossings met.  md5 08ff68f8a5363005afd09f5b98d968ce.  ON HARDWARE IT
# FAILED: Finder type-41 bomb on both boots, a corrupted glyph, the Starting Up bar drawn past its box.  Timing or logic
# undecided; P229 drops P215 (the associative MMU copies, suspected for the timing) to tell.
# P229 seed 25 2026-09-23 (f79a2ef: P220 - P215 + P221-P227, no CACHE_TINY): 39,631 ALMs (95 %), routes; CPU clock
# -1.313 ns (ifr_addr -> epf_data), HDMI +0.530, crossings met.  md5 de85957b0bb9bd86aef76280b139d3c0.
# P229 on hardware: FAILED like P220 -> bisect in the full-machine sim put the fault on P219 (P232 disables it).
# P231 (no P214) seed 25: -2.804 ns, not run; seed 27 stopped (P219 still in it).
# P232 seed 25 2026-09-23 (9644f5a): 39,780 ALMs (95 %), routing overran: CPU clock -17.833 ns (router congestion).
# Not usable.  CACHE_TINY back in the development profile (the P212+CACHE_TINY boot sim reached the Finder).
# P232 + CACHE_TINY seed 25 2026-09-23 (be552ad): 39,417 ALMs (94 %), CPU clock -9.753 ns, clk_ram -0.311 (congestion).
# Not usable.  Next: SCSI_CACHE_OFF (the block cache bypassed) in the development profile instead of CACHE_TINY.
# P232 + SCSI_CACHE_OFF (479d914) seed sweep 2026-09-23/24: seed 25 routing FAILED (38,907 ALMs, 93 %); 24 FAILED;
# 26 routed at -14.477 ns (unusable); 23 FAILED; 29 FAILED; seed 28 routes: 38,967 ALMs, 464 RAM blocks, CPU clock -2.165 ns (ctag_ram ->
# core), HDMI +0.123, clk_ram +0.602, crossings met.  md5 9e95e885a2567a53a1fa8e43a1a4d24d.  SEED 28 kept.
# Posted cross-line cache-store merge, validated on hardware.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_XSTORE=1"
# Overlap LEA displacement fetch with base selection; checked independently.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_LEA=1"
# P6 candidate: broaden the resident integer/memory stream at authentic 33 MHz.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE=1"
# Seqmem full fit cost 30 more ALMs; restore pipeline loads/stores.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_LOADS=1"
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_STORES=1"
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_PEA=1"
# P6 memory-entry trial: avoid unrestricted entry's measured Mix regression.
set_global_assignment -name VERILOG_MACRO "AP040_EXPERIMENTAL_PIPELINE_P6=1"
set_global_assignment -name VERILOG_MACRO "AP040_PIPELINE_MEMORY_ENTRY=1"
# P7 compare trial: indexed CMP/TST plus final-WB legacy handoff.
set_global_assignment -name VERILOG_MACRO "AP040_PIPELINE_COMPARE=1"
set_global_assignment -name VERILOG_MACRO "AP040_PIPELINE_EARLY_DRAIN=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_SHADOWMASK=1"
set_global_assignment -name VERILOG_MACRO "SCSI_CACHE_OFF=1"
set_global_assignment -name VERILOG_MACRO "MISTER_BYPASS_AUDIO_FILTER=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_VIDEO_CALC=1"
# 2026-09-29: VIDEO_512_OFF dropped for the release: the 12in 512x384 monitor option is back (pll_cfg ~360 ALMs).
#set_global_assignment -name VERILOG_MACRO "VIDEO_512_OFF=1"
set_global_assignment -name VERILOG_MACRO "CACHE_CD_OFF=1"
#set_global_assignment -name VERILOG_MACRO "VIDEO_512_OFF=1"
set_global_assignment -name VERILOG_MACRO "CACHE_SMALL=1"

#use only 1MB per frame for scaler to free ~21MB DDR3 RAM
#set_global_assignment -name VERILOG_MACRO "MISTER_SMALL_VBUF=1"

# Disable YC / Composite output to save some resources
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

