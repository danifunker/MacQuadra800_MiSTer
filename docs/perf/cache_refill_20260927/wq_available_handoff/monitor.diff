+// Passive scratch-only decision monitor. Inputs are observed before NBA.
+reg [3:0] observed_wp=0, observed_rp=0;
+reg observed_available=0;
+integer eq_edges=0, eq_true=0, eq_consumes=0, eq_init=0, eq_full=0;
+always @(negedge clk_ram) begin
+    observed_wp <= dut.wq_wp;
+    observed_rp <= dut.wq_rp;
+    observed_available <= (dut.wq_wp != dut.wq_rp);
+end
+always @(posedge clk_ram) begin
+    eq_edges=eq_edges+1;
+    if (dut.wq_rp !== observed_rp) $fatal(1,"HANDOFF rp changed between falling/rising edges");
+    if (observed_available !== (observed_wp != dut.wq_rp)) $fatal(1,"HANDOFF shadow decisions differ");
+`ifdef CANDIDATE
+    if (dut.wq_available_handoff !== observed_available) $fatal(1,"HANDOFF candidate differs from shadow");
+`else
+    if (dut.wq_wp_handoff !== observed_wp) $fatal(1,"HANDOFF baseline differs from shadow");
+`endif
+    if(observed_available) eq_true=eq_true+1;
+    if(!dut.rd_burst && !dut.busy_r && observed_available) eq_consumes=eq_consumes+1;
+    if(init) eq_init=eq_init+1;
+    if(dut.wq_full) eq_full=eq_full+1;
+end
+final begin
+    $display("HANDOFF_EQ edges=%0d true=%0d consume=%0d init=%0d full=%0d",eq_edges,eq_true,eq_consumes,eq_init,eq_full);
+    if(eq_edges<10000 || eq_consumes<300 || eq_init==0 || eq_full==0) $fatal(1,"HANDOFF insufficient coverage");
+end
