+
+// Independent monitor: records every accepted queue slot write and checks
+// the candidate's clk_ram consume against the exact published entry.
+module wq_slot_guard #(
+    parameter integer RAM_PERIOD_PS = 10100
+)(
+    input wire clk_sys, clk_ram, init, push,
+    input wire [3:0] wp, rp, published_wp, used,
+    input wire busy_r, rd_burst,
+    input wire [60:0] push_data, q
+);
+    reg [60:0] payload [0:7];
+    time written_at [0:7];
+    reg pending [0:7];
+    integer i;
+    integer pushes = 0;
+    integer consumes = 0;
+    integer pops = 0;
+    integer wraps = 0;
+    integer max_used = 0;
+    time min_age = 64'h7fffffffffffffff;
+    time max_age = 0;
+    integer push_slot;
+    integer consume_slot;
+    integer old_rp;
+    integer consume_event;
+    reg [60:0] consume_data;
+
+    initial begin
+        for (i = 0; i < 8; i = i + 1) begin
+            payload[i] = 61'd0;
+            written_at[i] = 0;
+            pending[i] = 0;
+        end
+    end
+
+    always @(posedge clk_sys) begin
+        if (!init && push) begin
+            push_slot = wp[2:0];
+            if (pending[push_slot])
+                $fatal(1, "WQ_GUARD overwrite before pop slot=%0d time=%0t", push_slot, $time);
+            payload[push_slot] = push_data;
+            written_at[push_slot] = $time;
+            pending[push_slot] = 1'b1;
+            pushes = pushes + 1;
+            if (wp[2:0] == 3'd7) wraps = wraps + 1;
+            #1ps;
+            if (used > max_used) max_used = used;
+        end
+    end
+
+    always @(posedge clk_ram) begin
+        consume_event = !init && !rd_burst && !busy_r && (published_wp != rp);
+        consume_slot = rp[2:0];
+        consume_data = q;
+        old_rp = rp[2:0];
+        #2ps;
+        if (consume_event) begin
+            if (!pending[consume_slot])
+                $fatal(1, "WQ_GUARD consumed unwritten/already-popped slot=%0d time=%0t", consume_slot, $time);
+            if (($time - written_at[consume_slot]) < RAM_PERIOD_PS)
+                $fatal(1, "WQ_GUARD consume too soon slot=%0d age=%0t min=%0d", consume_slot, $time - written_at[consume_slot], RAM_PERIOD_PS);
+            if (consume_data !== payload[consume_slot])
+                $fatal(1, "WQ_GUARD stale/corrupt consume slot=%0d got=%h expected=%h", consume_slot, consume_data, payload[consume_slot]);
+            if (($time - written_at[consume_slot]) < min_age) min_age = $time - written_at[consume_slot];
+            if (($time - written_at[consume_slot]) > max_age) max_age = $time - written_at[consume_slot];
+            consumes = consumes + 1;
+        end
+        if (rp[2:0] != old_rp) begin
+            if (!pending[old_rp])
+                $fatal(1, "WQ_GUARD pop without pending entry slot=%0d time=%0t", old_rp, $time);
+            pending[old_rp] = 1'b0;
+            pops = pops + 1;
+        end
+    end
+
+    final begin
+        $display("WQ_GUARD pushes=%0d consume-starts=%0d pops=%0d wraps=%0d max-used=%0d age-ps=[%0t,%0t]", pushes, consumes, pops, wraps, max_used, min_age, max_age);
+        if (pushes != pops)
+            $fatal(1, "WQ_GUARD unfinished entries pushes=%0d pops=%0d", pushes, pops);
+        for (integer j = 0; j < 8; j = j + 1)
+            if (pending[j]) $fatal(1, "WQ_GUARD pending at end slot=%0d", j);
+    end
+endmodule
