--- a/rtl/quadra800.sv
+++ b/rtl/quadra800.sv
@@ -1035,4 +1035,38 @@
 end
 endgenerate
 
+
+`ifdef SIMULATION
+// Graphics profile (simulation only, 2026-09-26): the CPU bus's time on VRAM
+// against RAM, per ~0.5 s of guest time (2^24 clocks).  Cycles count while a
+// CPU beat is presented (b_req) to that region; accesses count at b_ack.
+reg [23:0] gp_cyc;
+reg [31:0] gp_vr_cyc, gp_vw_cyc, gp_vr_n, gp_vw_n, gp_rr_cyc, gp_rw_cyc, gp_rr_n, gp_rw_n, gp_io_cyc, gp_busy;
+reg        gp_prev_req;
+reg [31:2] gp_prev_addr;
+reg        gp_prev_wr;
+always @(posedge clk) if (ce) begin
+	gp_cyc <= gp_cyc + 1'b1;
+	if (b_req) begin
+		gp_busy <= gp_busy + 1;
+		case (decode(b_addr))
+			3'd2: if (b_write) gp_vw_cyc <= gp_vw_cyc + 1; else gp_vr_cyc <= gp_vr_cyc + 1;
+			3'd0: if (b_write) gp_rw_cyc <= gp_rw_cyc + 1; else gp_rr_cyc <= gp_rr_cyc + 1;
+			default: gp_io_cyc <= gp_io_cyc + 1;
+		endcase
+	end
+	if (b_ack) case (decode(svc_addr))
+		3'd2: if (mem_write) gp_vw_n <= gp_vw_n + 1; else gp_vr_n <= gp_vr_n + 1;
+		3'd0: if (mem_write) gp_rw_n <= gp_rw_n + 1; else gp_rr_n <= gp_rr_n + 1;
+		default: ;
+	endcase
+	if (gp_cyc == 24'hFFFFFF) begin
+		$display("[GFX] vram rd %0d beats %0d cyc | vram wr %0d beats %0d cyc | ram rd %0d/%0d ram wr %0d/%0d | io %0d cyc | bus busy %0d of 16777216",
+		         gp_vr_n, gp_vr_cyc, gp_vw_n, gp_vw_cyc, gp_rr_n, gp_rr_cyc, gp_rw_n, gp_rw_cyc, gp_io_cyc, gp_busy);
+		gp_vr_cyc <= 0; gp_vw_cyc <= 0; gp_vr_n <= 0; gp_vw_n <= 0; gp_rr_cyc <= 0; gp_rw_cyc <= 0;
+		gp_rr_n <= 0; gp_rw_n <= 0; gp_io_cyc <= 0; gp_busy <= 0;
+	end
+end
+initial begin gp_cyc = 0; gp_vr_cyc = 0; gp_vw_cyc = 0; gp_vr_n = 0; gp_vw_n = 0; gp_rr_cyc = 0; gp_rw_cyc = 0; gp_rr_n = 0; gp_rw_n = 0; gp_io_cyc = 0; gp_busy = 0; end
+`endif
 endmodule
