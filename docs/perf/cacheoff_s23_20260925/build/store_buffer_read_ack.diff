> // buffer_req -> c_ack -> branch-refill seed, 2026-09-25).  For a write the
> // choice is unchanged; a read is never buffer_req.
> assign s_ack   = s_write ? (buffer_req ? (accept_ack | (push & s_posted)) :
>                             (direct_active ? m_ack : 1'b0)) :
