diff --git a/rtl/ap68040/tb/asm/t_cache.s b/rtl/ap68040/tb/asm/t_cache.s
index 3eaae30..0804f7e 100644
--- a/rtl/ap68040/tb/asm/t_cache.s
+++ b/rtl/ap68040/tb/asm/t_cache.s
@@ -51,6 +51,19 @@ start:
 	jsr	($2000).l
 	chkl	d0,2,4			; after CINV the new code runs
 
+	; P246: the line forms touch only their own line's set.  A CPUSHL of
+	; another line leaves the stale copy in place (as on a 68040); a CPUSHL
+	; of the stub's own line drops it.
+	move.w	#$7003,($2000).l	; memory now says moveq #3
+	lea	($2400).l,a0		; a different set
+	cpushl	ic,(a0)
+	jsr	($2000).l
+	chkl	d0,2,20			; the stub's line survived
+	lea	($2000).l,a0
+	cpushl	bc,(a0)
+	jsr	($2000).l
+	chkl	d0,3,21			; ... and its own CPUSHL dropped it
+
 ;----------------------------------------------- D-cache and stale data
 	move.l	#$0D0D0001,($3500).l	; write-through (invalidates the set)
 	move.l	($3500).l,d0		; fills the D-cache line
@@ -62,6 +75,17 @@ start:
 	move.l	($3500).l,d0
 	chkl	d0,$BEEF0000,7		; fresh after invalidation
 
+	; P246: CINVL on the data line drops a DMA-stale copy too
+	move.w	#$D00D,(POKEREG).l	; TB pokes $3500 = $D00D0000
+	move.l	($3500).l,d0
+	chkl	d0,$BEEF0000,22		; still the cached copy
+	lea	($3500).l,a1
+	cinvl	dc,(a1)
+	move.l	($3500).l,d0
+	chkl	d0,$D00D0000,23		; fresh after the line invalidate
+	move.w	#$BEEF,(POKEREG).l	; restore what the tests below expect
+	cinva	dc
+
 	; CPU writes stay coherent: write-through invalidates the line
 	move.l	($3508).l,d0		; cache the neighbouring longword
 	move.l	#$0D0D0002,($3508).l
