+					sweep_cnt <= sweep_line ? {1'b1, sweep_cnt[SETW-1:0]}
+					                        : sweep_cnt + {{(ROWIW-2){1'b0}}, 2'b10};
 					if (sweep_last) begin
 						if (!sweep_all) cinv_done <= 1;
 						sweep_all <= 0;
