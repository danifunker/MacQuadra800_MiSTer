+		`AP040_ALU_OR:  la_fl = {sr[4], la_msb(op_size, {1'b0, la_or}),  la_or  == 32'd0, 1'b0, 1'b0};
+		`AP040_ALU_EOR: la_fl = {sr[4], la_msb(op_size, {1'b0, la_eor}), la_eor == 32'd0, 1'b0, 1'b0};
